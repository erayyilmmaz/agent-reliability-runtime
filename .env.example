# Copy this file to .env for local overrides. Do not place real credentials here.
APP_DATABASE_URL=postgresql+asyncpg://runtime:runtime@localhost:5432/agent_runtime
APP_REDIS_URL=redis://localhost:6379/0
APP_RABBITMQ_URL=amqp://runtime:runtime@localhost:5672/
# APP_OPENAI_API_KEY=replace-with-a-local-secret
APP_OPENAI_BASE_URL=https://api.openai.com/v1
APP_OPENAI_DEFAULT_MODEL=gpt-5
APP_AUTH_MODE=disabled
APP_ENVIRONMENT=local
# Production defaults fail closed. Provision through a secret manager; see docs/security/credentials.md.
# APP_ENVIRONMENT=production
# APP_AUTH_MODE=api_key
# APP_AUTH_CREDENTIALS=<JSON registry of credential records>
# APP_AUTH_PEPPER=<independent cryptographically random secret, at least 32 characters>
# APP_RATE_LIMIT_REQUESTS=60
# APP_RATE_LIMIT_WINDOW_SECONDS=60
APP_WORKER_CONCURRENCY=4
APP_PROVIDER_TIMEOUT_SECONDS=60
APP_MAX_REQUEST_BYTES=131072
APP_REQUEST_BODY_TIMEOUT_SECONDS=10
APP_REGRESSION_MAX_CASES=10
APP_REGRESSION_PROVIDER_CALL_BUDGET=20
APP_PROVIDER_MAX_OUTPUT_TOKENS=2048
APP_PRINCIPAL_CONCURRENT_RUNS=20
APP_TENANT_CONCURRENT_RUNS=40
APP_PRINCIPAL_RUNNING_RUNS=1
APP_TENANT_RUNNING_RUNS=2
APP_PRINCIPAL_PROVIDER_CALLS=120
APP_TENANT_PROVIDER_CALLS=240
APP_QUOTA_WINDOW_SECONDS=3600
APP_AUDIT_FAILURE_POLICY=fail_closed
APP_AUDIT_WRITE_TIMEOUT_SECONDS=2
APP_TRUST_INBOUND_TRACE_CONTEXT=false
APP_DETERMINISTIC_ECHO_INPUT=false
APP_PAYLOAD_RETENTION_DAYS=30
APP_RETRY_MAX_ATTEMPTS=3
APP_RETRY_BASE_DELAY_SECONDS=1
APP_RETRY_MAX_BACKOFF_SECONDS=60
APP_RETRY_ATTEMPT_TIMEOUT_SECONDS=60
APP_RETRY_SCHEDULER_POLL_INTERVAL_SECONDS=1
APP_OUTBOX_BATCH_SIZE=50
APP_OUTBOX_POLL_INTERVAL_SECONDS=1
APP_OUTBOX_PUBLISH_TIMEOUT_SECONDS=10
APP_EXECUTION_LEASE_SECONDS=120
APP_LEASE_RECOVERY_POLL_INTERVAL_SECONDS=5
APP_OTEL_ENABLED=true
APP_OTEL_ENDPOINT=http://localhost:4318
APP_LOG_LEVEL=INFO
