# Copy this file to .env for local overrides. Do not place real credentials here.
APP_DATABASE_URL=postgresql+asyncpg://runtime:runtime@localhost:5432/agent_runtime
APP_REDIS_URL=redis://localhost:6379/0
APP_RABBITMQ_URL=amqp://runtime:runtime@localhost:5672/
APP_AUTH_MODE=disabled
# APP_AUTH_TOKEN=replace-with-a-local-secret
APP_WORKER_CONCURRENCY=4
APP_PROVIDER_TIMEOUT_SECONDS=60
APP_RETRY_MAX_ATTEMPTS=3
APP_RETRY_BASE_DELAY_SECONDS=1
APP_OTEL_ENDPOINT=http://localhost:4318
APP_LOG_LEVEL=INFO
